{
  "$defs": {
    "ApprovalsReviewer": {
      "description": "Routes approval requests to the user or automatic review. The legacy guardian_subagent input is serialized as auto_review.",
      "enum": [
        "auto_review",
        "guardian_subagent",
        "user"
      ],
      "type": "string"
    },
    "DynamicToolFunctionSpec": {
      "properties": {
        "deferLoading": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "inputSchema": true,
        "name": {
          "type": "string"
        }
      },
      "required": [
        "description",
        "inputSchema",
        "name"
      ],
      "type": "object"
    },
    "DynamicToolNamespaceSpec": {
      "properties": {
        "description": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "tools": {
          "items": {
            "$ref": "#/$defs/DynamicToolNamespaceTool"
          },
          "type": "array"
        }
      },
      "required": [
        "description",
        "name",
        "tools"
      ],
      "type": "object"
    },
    "DynamicToolNamespaceTool": {
      "oneOf": [
        {
          "$ref": "#/$defs/DynamicToolFunctionSpec",
          "properties": {
            "type": {
              "const": "function",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "DynamicToolSpec": {
      "oneOf": [
        {
          "$ref": "#/$defs/DynamicToolFunctionSpec",
          "properties": {
            "type": {
              "const": "function",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/DynamicToolNamespaceSpec",
          "properties": {
            "type": {
              "const": "namespace",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "SortDirection": {
      "enum": [
        "asc",
        "desc"
      ],
      "type": "string"
    },
    "ThreadResumeInitialTurnsPageParams": {
      "properties": {
        "itemsView": {
          "anyOf": [
            {
              "$ref": "#/$defs/TurnItemsView"
            },
            {
              "type": "null"
            }
          ]
        },
        "limit": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "sortDirection": {
          "anyOf": [
            {
              "$ref": "#/$defs/SortDirection"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "TurnItemsView": {
      "enum": [
        "full",
        "notLoaded",
        "summary"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "approvalPolicy": true,
    "approvalsReviewer": {
      "anyOf": [
        {
          "$ref": "#/$defs/ApprovalsReviewer"
        },
        {
          "type": "null"
        }
      ]
    },
    "baseInstructions": {
      "type": [
        "null",
        "string"
      ]
    },
    "config": {
      "additionalProperties": true,
      "type": [
        "null",
        "object"
      ]
    },
    "cwd": {
      "type": [
        "null",
        "string"
      ]
    },
    "developerInstructions": {
      "type": [
        "null",
        "string"
      ]
    },
    "dynamicTools": {
      "description": "Declares this connection as the host for the thread's frozen dynamic tools.\nThis cannot change their schemas or replace a live host.",
      "items": {
        "$ref": "#/$defs/DynamicToolSpec"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "excludeTurns": {
      "type": "boolean"
    },
    "history": {
      "items": true,
      "type": [
        "array",
        "null"
      ]
    },
    "initialTurnsPage": {
      "anyOf": [
        {
          "$ref": "#/$defs/ThreadResumeInitialTurnsPageParams"
        },
        {
          "type": "null"
        }
      ]
    },
    "model": {
      "type": [
        "null",
        "string"
      ]
    },
    "modelProvider": {
      "type": [
        "null",
        "string"
      ]
    },
    "path": {
      "type": [
        "null",
        "string"
      ]
    },
    "permissions": {
      "type": [
        "null",
        "string"
      ]
    },
    "personality": true,
    "runtimeWorkspaceRoots": {
      "items": {
        "type": "string"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "sandbox": true,
    "serviceTier": {
      "type": [
        "null",
        "string"
      ]
    },
    "threadId": {
      "type": "string"
    }
  },
  "required": [
    "threadId"
  ],
  "title": "ThreadResumeParams",
  "type": "object"
}
