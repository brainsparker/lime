{
  "$defs": {
    "AbsolutePathBuf": {
      "description": "A host path validated when entering the protocol boundary.",
      "type": "string"
    },
    "PluginShareDiscoverability": {
      "enum": [
        "LISTED",
        "PRIVATE",
        "UNLISTED"
      ],
      "type": "string"
    },
    "PluginSharePrincipalType": {
      "enum": [
        "group",
        "user",
        "workspace"
      ],
      "type": "string"
    },
    "PluginShareTarget": {
      "properties": {
        "principalId": {
          "type": "string"
        },
        "principalType": {
          "$ref": "#/$defs/PluginSharePrincipalType"
        },
        "role": {
          "$ref": "#/$defs/PluginShareTargetRole"
        }
      },
      "required": [
        "principalId",
        "principalType",
        "role"
      ],
      "type": "object"
    },
    "PluginShareTargetRole": {
      "enum": [
        "editor",
        "reader"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "discoverability": {
      "anyOf": [
        {
          "$ref": "#/$defs/PluginShareDiscoverability"
        },
        {
          "type": "null"
        }
      ]
    },
    "pluginPath": {
      "$ref": "#/$defs/AbsolutePathBuf"
    },
    "remotePluginId": {
      "type": [
        "null",
        "string"
      ]
    },
    "shareTargets": {
      "items": {
        "$ref": "#/$defs/PluginShareTarget"
      },
      "type": [
        "array",
        "null"
      ]
    }
  },
  "required": [
    "pluginPath"
  ],
  "title": "PluginShareSaveParams",
  "type": "object"
}
