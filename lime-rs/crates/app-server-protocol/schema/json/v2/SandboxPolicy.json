{
  "$defs": {
    "AbsolutePathBuf": {
      "description": "A host path validated when entering the protocol boundary.",
      "type": "string"
    },
    "NetworkAccess": {
      "enum": [
        "enabled",
        "restricted"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Complete execution policy; roots and temporary-directory exclusions must reach the OS runner.",
  "oneOf": [
    {
      "properties": {
        "type": {
          "const": "dangerFullAccess",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    {
      "properties": {
        "networkAccess": {
          "default": false,
          "type": "boolean"
        },
        "type": {
          "const": "readOnly",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    {
      "properties": {
        "networkAccess": {
          "$ref": "#/$defs/NetworkAccess",
          "default": "restricted"
        },
        "type": {
          "const": "externalSandbox",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    {
      "properties": {
        "excludeSlashTmp": {
          "default": false,
          "type": "boolean"
        },
        "excludeTmpdirEnvVar": {
          "default": false,
          "type": "boolean"
        },
        "networkAccess": {
          "default": false,
          "type": "boolean"
        },
        "type": {
          "const": "workspaceWrite",
          "type": "string"
        },
        "writableRoots": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AbsolutePathBuf"
          },
          "type": "array"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    }
  ],
  "title": "SandboxPolicy"
}
