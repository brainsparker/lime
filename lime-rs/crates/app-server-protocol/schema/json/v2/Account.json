        },
        "displayName": {
          "type": [
            "null",
            "string"
          ]
        },
        "email": {
          "type": [
            "null",
            "string"
          ]
        },
        "expiresAt": {
          "type": [
            "null",
            "string"
          ]
        },
        "sessionId": {
          "type": "string"
        },
        "tenantId": {
          "type": "string"
        },
        "type": {
