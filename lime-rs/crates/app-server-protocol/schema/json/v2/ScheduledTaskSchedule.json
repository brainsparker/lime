        "type"
      ],
      "type": "object"
    },
    {
      "properties": {
        "time": {
          "type": "string"
        },
        "type": {
          "const": "daily",
          "type": "string"
        }
      },
      "required": [
        "time",
        "type"
      ],
      "type": "object"
    },
    {
      "properties": {
        "time": {
          "type": "string"
        },
        "type": {
          "const": "weekdays",
          "type": "string"
        }
      },
      "required": [
        "time",
        "type"
      ],
      "type": "object"
    },
    {
      "properties": {
        "days": {
          "items": {
            "$ref": "#/$defs/ScheduledTaskWeekday"
          },
          "type": "array"
        },
        "time": {
          "type": "string"
        },
        "type": {
          "const": "weekly",
          "type": "string"
        }
      },
      "required": [
        "days",
        "time",
        "type"
      ],
      "type": "object"
    }
  ],
  "title": "ScheduledTaskSchedule"
}
