import fs from 'node:fs';
import path from 'node:path';
import {createHash} from 'node:crypto';
const root='/Users/coso/Documents/dev/ai/aiclientproxy/lime';process.chdir(root);
const base='internal/exec-plans/artifacts/codex-rollout-context-20261021';
const log=fs.readFileSync(base+'/lifecycle-agent-r31.log','utf8');
const result=JSON.parse(fs.readFileSync(base+'/lifecycle-agent-r31.json','utf8'));
const paths=[...new Set([...log.matchAll(/summary=(\/[^\r\n]+)/g)].map(m=>m[1].trim()))].filter(p=>p.startsWith(root+'/.lime/qc/gui-evidence/')&&p.endsWith('.json'));
const copied=[];
for(const [index,source] of paths.entries()){
 const bytes=fs.readFileSync(source);const summary=JSON.parse(bytes);
 const modifiedAt=fs.statSync(source).mtime;
 if(modifiedAt.getTime()<Date.parse(result.started)||modifiedAt.getTime()>Date.parse(result.ended)+1000)throw new Error('Scene evidence is outside this run: '+source);
 const destination=path.join(base,'lifecycle-agent-r31-scene-'+String(index+1).padStart(2,'0')+'-'+path.basename(source));
 fs.writeFileSync(destination,bytes);copied.push({source,destination,sha256:createHash('sha256').update(bytes).digest('hex'),modifiedAt:modifiedAt.toISOString(),result:summary.result??summary.ok??null});
}
const executedUnitTests=[...log.matchAll(/: executed=(\d+)/g)].map(m=>Number(m[1]));
fs.writeFileSync(base+'/lifecycle-agent-r31-scenes.json',JSON.stringify({capturedAt:new Date().toISOString(),executedUnitTests,totalExecutedUnitTests:executedUnitTests.reduce((a,b)=>a+b,0),copied},null,2)+'\n');
console.log(JSON.stringify({sceneCount:copied.length,executedUnitTests,status:result.code,allSceneSummariesPassed:copied.every(c=>c.result===true||c.result==='pass')}));
