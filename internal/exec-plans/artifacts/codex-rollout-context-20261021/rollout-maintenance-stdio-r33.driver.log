const frames=[],pending=new Map();let counter=0,stderr='',writer;
const sha=file=>createHash('sha256').update(fs.readFileSync(file)).digest('hex');
fs.writeFileSync(config,'{}\n');
await writeTerminalExternalBackend(backend,{completedText:'MAINTENANCE_STDIO_COMPLETED',command:'unused',completeAgentMessage:true});
const child=spawn(binary,['--stdio','--backend','external','--backend-command',process.execPath,'--backend-arg',backend,'--backend-arg',ledger,'--data-dir',data,'--app-data-dir',path.join(temporary,'app')],{
 cwd:temporary,env:{...process.env,LIME_CONFIG_PATH:config,DYLD_LIBRARY_PATH:path.dirname(binary),LIME_ALLOW_LIVE_PROVIDER_SMOKE:'0',LIME_REAL_API_TEST:'0'},stdio:['pipe','pipe','pipe'],
});
child.stderr.on('data',chunk=>{stderr+=chunk;});
createInterface({input:child.stdout}).on('line',line=>{
 try { const frame=JSON.parse(line); frames.push(frame);const entry=pending.get(frame.id);
 if(entry){pending.delete(frame.id);clearTimeout(entry.timer);entry.resolve(frame);}
 } catch(error){stderr+='\ninvalid JSONL: '+line+' '+error;}
});
child.on('exit',code=>{for(const entry of pending.values()){clearTimeout(entry.timer);entry.reject(new Error('sidecar exit '+code+' '+stderr.slice(-3000)));}pending.clear();});
const notify=(method,params)=>child.stdin.write(JSON.stringify({method,params})+'\n');
function request(method,params){const id=++counter;return new Promise((resolve,reject)=>{
 const timer=setTimeout(()=>{pending.delete(id);reject(new Error('RPC timeout '+method+' '+stderr.slice(-3000)));},20000);
 pending.set(id,{resolve,reject,timer});child.stdin.write(JSON.stringify({id,method,...(params===undefined?{}:{params})})+'\n');
});}
async function rpc(method,params){const result=await request(method,params);assert.ok(!result.error,JSON.stringify(result));return result.result;}
async function waitFor(predicate,label){const deadline=Date.now()+20000;while(!predicate()){assert.ok(Date.now()<deadline,label+' '+stderr.slice(-1000));await new Promise(resolve=>setTimeout(resolve,10));}}
async function turn(threadId,text){const result=await rpc('turn/start',{threadId,input:[{type:'text',text}]});
 await waitFor(()=>frames.some(frame=>frame.method==='turn/completed'&&frame.params?.threadId===threadId&&frame.params?.turn?.id===result.turn.id),'turn completed');}
function files(directory){return fs.readdirSync(directory,{withFileTypes:true}).flatMap(entry=>entry.isDirectory()?files(path.join(directory,entry.name)):[path.join(directory,entry.name)]);}
const aged=new Date(Date.now()-8*24*60*60*1000);
async function waitForPass(){const marker=path.join(data,'.tmp/rollout-compression.lock');await waitFor(()=>fs.existsSync(marker),'worker marker');
 const result=spawnSync('python3',['-c','import fcntl,sys\nf=open(sys.argv[1],"r+")\nfcntl.flock(f,fcntl.LOCK_EX)\n',path.join(data,'.tmp/rollout-maintenance.lock')],{encoding:'utf8',timeout:20000});assert.equal(result.status,0,result.stderr);}
async function holdWriter(lockPath){const owner=spawn('python3',['-u','-c','import fcntl,sys\nf=open(sys.argv[1],"a+")\nfcntl.flock(f,fcntl.LOCK_EX)\nprint("owned",flush=True)\nsys.stdin.read(1)\n',lockPath],{stdio:['pipe','pipe','pipe']});
 await new Promise((resolve,reject)=>{owner.stdout.once('data',resolve);owner.once('error',reject);owner.once('exit',code=>reject(new Error('writer exited '+code)));});return owner;}

const started=new Date().toISOString();
try {
 const initialized=await rpc('initialize',{clientInfo:{name:'maintenance-stdio-fixture',version:'1.0.0'},capabilities:{experimentalApi:true}});
 assert.equal(initialized.serverInfo.protocolVersion,'appserver.v0');notify('initialized',{});
 const initial=await rpc('thread/start',{model:'fixture-model',modelProvider:'fixture-provider',cwd:temporary});
 const id=initial.thread.id;await turn(id,'maintenance seed');
 const rollout=files(path.join(data,'sessions')).find(file=>file.endsWith('-'+id+'.jsonl'));assert.ok(rollout);
 fs.utimesSync(rollout,aged,aged);const bytes=fs.readFileSync(rollout),mtime=fs.statSync(rollout).mtimeMs;
 const lockPath=path.join(data,'thread-writer-locks',id+'.lock');writer=await holdWriter(lockPath);
 assert.deepEqual(await rpc('rollout/compress'),{});await waitForPass();
 assert.ok(fs.existsSync(rollout),'cross-process writer must exclude publication');
 assert.ok(!fs.existsSync(rollout+'.zst'));assert.deepEqual(fs.readFileSync(rollout),bytes);
 const exited=new Promise(resolve=>writer.once('exit',resolve));writer.stdin.end('x');await exited;writer=undefined;
 fs.utimesSync(path.join(data,'.tmp/rollout-compression.lock'),aged,aged);
 assert.deepEqual(await rpc('rollout/compress',{}),{});await waitForPass();
 assert.ok(!fs.existsSync(rollout));assert.ok(fs.existsSync(rollout+'.zst'));
 assert.equal(fs.statSync(rollout+'.zst').mtimeMs,mtime);
 const compressedSha=sha(rollout+'.zst');
 const read=await rpc('thread/read',{threadId:id,includeTurns:true});assert.equal(read.thread.id,id);assert.equal(read.thread.turns.length,1);assert.ok(!fs.existsSync(rollout));
 const rejected=await request('thread/unarchive',{threadId:id});assert.equal(rejected.error?.code,-32600);
 assert.equal(rejected.error.message,'no archived rollout found for thread id '+id);assert.equal(sha(rollout+'.zst'),compressedSha);
 await turn(id,'maintenance continuation');assert.ok(fs.existsSync(rollout));assert.ok(!fs.existsSync(rollout+'.zst'));
 const final=await rpc('thread/read',{threadId:id,includeTurns:true});assert.equal(final.thread.turns.length,2);
 for(const turn of final.thread.turns)assert.equal(turn.status,'completed');
 const report={status:'pass',started,ended:new Date().toISOString(),scope:'real App Server stdio + canonical Thread/Turn/Item, controlled external backend; actual Python/flock cross-process writer exclusion; no live provider/PTY/Windows claim',binary:{path:binary,sha256:sha(binary)},temporary,threadId:id,compressedSha,mtime,turns:final.thread.turns.map(turn=>({id:turn.id,status:turn.status})),frames};
 fs.writeFileSync(path.join(evidence,'maintenance-stdio-r32.json'),JSON.stringify(report,null,2)+'\n');console.log(JSON.stringify({status:'pass',threadId:id,turns:2,temporary}));
} catch(error){fs.writeFileSync(path.join(evidence,'maintenance-stdio-r32.json'),JSON.stringify({status:'fail',started,ended:new Date().toISOString(),temporary,error:String(error.stack),stderr,frames},null,2)+'\n');throw error;}
finally {writer?.stdin.end('x');child.stdin.end();await Promise.race([new Promise(resolve=>child.once('exit',resolve)),new Promise(resolve=>setTimeout(resolve,5000))]);if(child.exitCode===null)child.kill();}
