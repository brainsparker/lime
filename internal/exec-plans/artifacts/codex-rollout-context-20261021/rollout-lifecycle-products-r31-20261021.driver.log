import fs from 'node:fs';
import path from 'node:path';
import {spawn} from 'node:child_process';
import {createHash} from 'node:crypto';
import {resolveRustyV8CargoEnv} from '/Users/coso/Documents/dev/ai/aiclientproxy/lime/scripts/lib/rusty-v8-artifacts.mjs';
const root='/Users/coso/Documents/dev/ai/aiclientproxy/lime';
process.chdir(root);
const base='internal/exec-plans/artifacts/codex-rollout-context-20261021';
const freeze=JSON.parse(fs.readFileSync(base+'/lifecycle-implementation-r31.json','utf8'));
const sha=file=>createHash('sha256').update(fs.readFileSync(file)).digest('hex');
for(const name of ['lifecycle-owner-r31','lifecycle-integration-r31','lifecycle-binaries-r31','lifecycle-public-thread-r31']){
 const result=JSON.parse(fs.readFileSync(`${base}/${name}.json`,'utf8'));
 if(result.code!==0||result.sourceDrift.length) throw new Error('Prerequisite failed: '+name);
}
const env={...process.env,...resolveRustyV8CargoEnv(),PATH:'/tmp/rollout-cargo-tools-20261021:'+process.env.PATH,CARGO_TARGET_DIR:'/Users/coso/Documents/dev/ai/aiclientproxy/lime/lime-rs/target',CARGO_BUILD_JOBS:'1',RUST_MIN_STACK:'8388608',APP_SERVER_BIN:'/Users/coso/Documents/dev/ai/aiclientproxy/lime/lime-rs/target/debug/app-server'};
for(const key of ['CARGO_PROFILE_DEV_DEBUG','CARGO_PROFILE_TEST_DEBUG','CARGO_INCREMENTAL']) delete env[key];
const tasks=[
 ['lifecycle-gui-r31','npm',['run','verify:gui-smoke'],{LIME_GATE_RUN_ID:'lifecycle-r31',LIME_ELECTRON_SMOKE_EVIDENCE_DIR:path.resolve(base,'lifecycle-gui-r31')}],
 ['lifecycle-cli-process-r31',process.execPath,['/tmp/rollout-lifecycle-cli-r31-20261021.mjs'],{}],
 ['lifecycle-archived-gui-r31',process.execPath,['scripts/electron/settings-archived-lifecycle-fixture-smoke.mjs','--run-id','lifecycle-r31','--evidence-dir',path.resolve(base,'lifecycle-archived-gui-r31'),'--prefix','lifecycle-archive-r31'],{}],
 ['lifecycle-agent-r31','npm',['run','smoke:agent-runtime-current-fixture'],{}],
];
for(const [name,command,args,extraEnv] of tasks){
 const drift=freeze.files.filter(file=>sha(file.path)!==file.sha256).map(file=>file.path);
 if(drift.length) throw new Error('Source changed before product validation: '+drift.join(', '));
 const started=new Date().toISOString();
 const out=fs.openSync(`${base}/${name}.log`,'w');
 const child=spawn(command,args,{cwd:root,env:{...env,...extraEnv},stdio:['ignore',out,out]});
 const result=await new Promise((resolve,reject)=>{child.once('error',reject);child.once('exit',(code,signal)=>resolve({code,signal}));});
