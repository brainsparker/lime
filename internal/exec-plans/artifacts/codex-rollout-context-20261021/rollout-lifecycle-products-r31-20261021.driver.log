 fs.writeFileSync(`${base}/${name}.json`,JSON.stringify({started,ended:new Date().toISOString(),command:[command,...args],...result,sourceDrift,appServer:{path:env.APP_SERVER_BIN,sha256:sha(env.APP_SERVER_BIN)}},null,2)+'\n');
 console.log(JSON.stringify({name,...result,sourceDrift}));
 if(result.code!==0||sourceDrift.length){process.exitCode=result.code||1;break;}
