import errno
import fcntl
import json
import os
import pty
import select
import signal
import struct
import subprocess
import termios
import time
from pathlib import Path

root = Path(__file__).resolve().parent
binaries = root.parent / "binaries"
env = dict(os.environ)
env.update({
    "HOME": str(root / "home"),
    "XDG_CONFIG_HOME": str(root / "config"),
    "XDG_DATA_HOME": str(root / "xdg-data"),
    "APPDATA": str(root / "app-data"),
    "LOCALAPPDATA": str(root / "local-app-data"),
    "DYLD_LIBRARY_PATH": str(binaries),
    "TERM": "xterm-256color",
    "LIME_LOCALE": "en-US",
})
connection = [
    "--cd", str(root / "work"), "--model", "fixture-model",
    "--provider", "fixture-provider", "--app-server", str(binaries / "app-server"),
    "--app-server-arg=--backend", "--app-server-arg=external",
    "--app-server-arg=--backend-command",
    "--app-server-arg=" + (root / "node-path.txt").read_text(),
    "--app-server-arg=--backend-arg", "--app-server-arg=" + str(root / "backend.mjs"),
    "--app-server-arg=--backend-arg", "--app-server-arg=" + str(root / "ledger.jsonl"),
    "--app-server-arg=--backend-timeout-ms", "--app-server-arg=5000",
    "--app-server-arg=--data-dir", "--app-server-arg=" + str(root / "data"),
    "--app-server-arg=--app-data-dir", "--app-server-arg=" + str(root / "app-data"),
]
master, slave = pty.openpty()
fcntl.ioctl(slave, termios.TIOCSWINSZ, struct.pack("HHHH", 30, 120, 0, 0))
before = termios.tcgetattr(slave)
pid = os.fork()
if pid == 0:
    os.close(master)
    os.setsid()
    fcntl.ioctl(slave, termios.TIOCSCTTY, 0)
    for fd in (0, 1, 2):
        os.dup2(slave, fd)
    if slave > 2:
        os.close(slave)
    os.chdir(root / "work")
    os.execve(str(binaries / "lime"), [str(binaries / "lime"), "tui", *connection], env)

output = bytearray()
status = None
result = {"proofLevel": "targeted real PTY", "backend": "external controlled fixture", "ok": False}

def until(marker, timeout=30):
    deadline = time.monotonic() + timeout
    start = len(output)
    while time.monotonic() < deadline:
        if marker in output[start:]:
            return
        if not select.select([master], [], [], min(0.2, max(0, deadline - time.monotonic())))[0]:
            continue
        try:
            chunk = os.read(master, 65536)
        except OSError as error:
            if error.errno == errno.EIO:
                raise AssertionError("TUI exited before expected marker " + repr(marker)) from error
            raise
        assert chunk, "PTY ended before expected marker"
        output.extend(chunk)
        if b"\x1b[6n" in chunk:
            os.write(master, b"\x1b[1;1R")
    raise AssertionError("timed out waiting for " + repr(marker))

try:
    until(b"Ask Lime to do anything")
    assert b"\x1b[?1049h" in output, "entered alternate screen"
    assert termios.tcgetattr(slave) != before, "TUI entered terminal raw mode"
    prompt = "portable rollout PTY input"
    os.write(master, prompt.encode())
    until(prompt.encode())
    os.write(master, b"\r")
    until(b"ROLLOUT_PTY_COMPLETED")
    os.write(master, b"\x04")
    deadline = time.monotonic() + 15
    while time.monotonic() < deadline:
        reaped, status = os.waitpid(pid, os.WNOHANG)
        if reaped:
            break
        if select.select([master], [], [], 0.1)[0]:
            try:
                output.extend(os.read(master, 65536))
            except OSError as error:
                if error.errno != errno.EIO:
                    raise
    else:
        raise AssertionError("TUI did not exit after keyboard Ctrl-D")
    assert os.waitstatus_to_exitcode(status) == 0, f"TUI exit status {status}"
    assert b"\x1b[?1049l" in output, "left alternate screen"
    assert termios.tcgetattr(master) == before, "terminal flags restored exactly"
    encoded = (root / "ledger.jsonl").read_text()
    ledger = []
    decoder = json.JSONDecoder()
    while encoded:
        entry, consumed = decoder.raw_decode(encoded)
        ledger.append(entry)
        encoded = encoded[consumed:].removeprefix("\\n").lstrip()
    starts = [entry for entry in ledger if entry.get("kind") == "turnStart"]
    assert len(starts) == 1, f"one keyboard submission: {starts}"
    identity = starts[0]
    cold = subprocess.run([str(binaries / "lime"), "thread", "show", identity["threadId"], "--include-turns", *connection], env=env, text=True, capture_output=True, timeout=30)
    assert cold.returncode == 0, cold.stderr
    thread = json.loads(cold.stdout)["thread"]
    (root / "canonical.json").write_text(json.dumps(thread, indent=2) + "\n")
    assert thread["id"] == identity["threadId"]
    assert len(thread["turns"]) == 1
    turn = thread["turns"][0]
    assert turn["id"] == identity["turnId"] and turn["status"] == "completed"
    assert any(item.get("text") == "ROLLOUT_PTY_COMPLETED" for item in turn["items"]), turn["items"]
    result.update(ok=True, threadId=thread["id"], turnId=turn["id"], alternateScreen=True, keyboardSubmit=True, terminalRestored=True, coldCanonical=True, exitCode=0)
    print("TUI_PTY_BASIC_OK " + json.dumps(result))
except BaseException as error:
    result["error"] = repr(error)
    raise
finally:
    if status is None:
        try:
            os.kill(pid, signal.SIGTERM)
            os.waitpid(pid, 0)
        except ProcessLookupError:
            pass
    (root / "transcript.log").write_bytes(output)
    (root / "summary.json").write_text(json.dumps(result, indent=2) + "\n")
    os.close(master)
    os.close(slave)
