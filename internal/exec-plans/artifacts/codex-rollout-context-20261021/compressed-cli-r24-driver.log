import fs from 'node:fs';
import path from 'node:path';
import os from 'node:os';
import assert from 'node:assert/strict';
import {spawnSync} from 'node:child_process';
import {createHash} from 'node:crypto';
import {writeTerminalExternalBackend} from '/Users/coso/Documents/dev/ai/aiclientproxy/lime/scripts/app-server/terminal-gate-fixture.mjs';

const root='/Users/coso/Documents/dev/ai/aiclientproxy/lime';
const target='/tmp/lime-rollout-compressed-target-20261021/debug';
const cli=path.join(target,'lime');
const server=path.join(target,'app-server');
const evidence=path.join(root,'internal/exec-plans/artifacts/codex-rollout-context-20261021');
const temp=fs.mkdtempSync(path.join(os.tmpdir(),'compressed-rollout-cli-'));
const backend=path.join(temp,'backend.mjs');
const ledger=path.join(temp,'requests.jsonl');
const answer='COMPRESSED_ROLLOUT_CLI_COMPLETED';
const runs=[];
const sha=file=>createHash('sha256').update(fs.readFileSync(file)).digest('hex');
fs.mkdirSync(path.join(temp,'home'));
const env={...process.env,HOME:path.join(temp,'home'),XDG_CONFIG_HOME:path.join(temp,'home/config'),XDG_DATA_HOME:path.join(temp,'home/data'),APPDATA:path.join(temp,'home/roaming'),LOCALAPPDATA:path.join(temp,'home/local'),DYLD_LIBRARY_PATH:target,LIME_ALLOW_LIVE_PROVIDER_SMOKE:'0',LIME_REAL_API_TEST:'0'};
await writeTerminalExternalBackend(backend,{completedText:answer,command:'unused',scenario:'compressed-rollout',completeAgentMessage:true});
const connection=home=>['--app-server',server,'--app-server-arg=--backend','--app-server-arg=external','--app-server-arg=--backend-command',`--app-server-arg=${process.execPath}`,'--app-server-arg=--backend-arg',`--app-server-arg=${backend}`,'--app-server-arg=--backend-arg',`--app-server-arg=${ledger}`,'--app-server-arg=--data-dir',`--app-server-arg=${home}/data`,'--app-server-arg=--app-data-dir',`--app-server-arg=${home}/app`];
function run(label,args){
 const result=spawnSync(cli,args,{cwd:temp,env,encoding:'utf8',timeout:120000,maxBuffer:8*1024*1024});
 runs.push({label,args,status:result.status,signal:result.signal,stdout:result.stdout,stderr:result.stderr});
 assert.equal(result.status,0,`${label}: ${result.stderr}\n${result.stdout}`);
 return result.stdout;
}
function files(dir){return fs.readdirSync(dir,{withFileTypes:true}).flatMap(entry=>entry.isDirectory()?files(path.join(dir,entry.name)):[path.join(dir,entry.name)]);}
function seedOnlyCompressed(from,to,id){
 const rollouts=files(path.join(from,'data')).filter(file=>path.basename(file).startsWith('rollout-')&&file.endsWith(`-${id}.jsonl`));
 assert.equal(rollouts.length,1,'one canonical rollout');
 const relative=path.relative(path.join(from,'data'),rollouts[0]);
 const destination=path.join(to,'data',relative);
 fs.mkdirSync(path.dirname(destination),{recursive:true});
 fs.copyFileSync(rollouts[0],destination);
 const result=spawnSync('zstd',['-q','--rm',destination],{encoding:'utf8'});
 assert.equal(result.status,0,result.stderr);
 assert.deepEqual(files(to),[`${destination}.zst`],'new home contains only compressed rollout');
 return {destination,compressedSha256:sha(`${destination}.zst`)};
}
try {
 const original=path.join(temp,'original');
 const first=path.join(temp,'first');
 const second=path.join(temp,'second');
 const initial=run('seed',['exec','compressed original CLI input','--json','--cd',temp,'--model','fixture-model','--provider','fixture-provider',...connection(original)]).trim().split('\n').map(line=>JSON.parse(line));
 const id=initial.find(event=>event.type==='thread.started').thread_id;
 assert.equal(initial.at(-1).type,'turn.completed');
 const copied=seedOnlyCompressed(original,first,id);
 fs.rmSync(original,{recursive:true});
 const read=JSON.parse(run('compressed-only-read',['thread','show',id,'--include-turns',...connection(first)]));
 assert.equal(read.thread.id,id);assert.equal(read.thread.turns.length,1);
 assert.ok(JSON.stringify(read.thread.turns[0]).includes('compressed original CLI input'));
 assert.ok(!fs.existsSync(copied.destination),'read must not materialize');
 const continued=run('compressed-only-resume',['exec','resume',id,'compressed first CLI continuation','--json','--cd',temp,'--model','fixture-model','--provider','fixture-provider',...connection(first)]).trim().split('\n').map(line=>JSON.parse(line));
 assert.equal(continued.find(event=>event.type==='thread.started').thread_id,id);
 assert.equal(continued.at(-1).type,'turn.completed');
 assert.ok(continued.some(event=>event.item?.text===answer));
 assert.ok(fs.existsSync(copied.destination));assert.ok(!fs.existsSync(`${copied.destination}.zst`));
 const twice=seedOnlyCompressed(first,second,id);
 fs.rmSync(first,{recursive:true});
 run('second-empty-index-resume',['exec','resume',id,'compressed second CLI continuation','--json','--cd',temp,'--model','fixture-model','--provider','fixture-provider',...connection(second)]);
 const final=JSON.parse(run('final-canonical-read',['thread','show',id,'--include-turns',...connection(second)]));
 assert.equal(final.thread.id,id);assert.equal(final.thread.turns.length,3);
 for(const [i,text] of ['compressed original CLI input','compressed first CLI continuation','compressed second CLI continuation'].entries()){
  assert.ok(JSON.stringify(final.thread.turns[i]).includes(text),`${i}: ${text}`);
  assert.equal(final.thread.turns[i].status,'completed');
 }
 const requests=fs.readFileSync(ledger,'utf8').trim().split('\n').map(line=>JSON.parse(line));
 for(const text of ['compressed original CLI input','compressed first CLI continuation','compressed second CLI continuation']){
  const matching=requests.filter(request=>request.kind==='turnStart'&&request.inputText===text);
  assert.equal(matching.length,1,text);assert.equal(matching[0].threadId,id);
 }
 fs.writeFileSync(path.join(evidence,'compressed-cli-r24-canonical.json'),JSON.stringify(final,null,2)+'\n');
 fs.writeFileSync(path.join(evidence,'compressed-cli-r24.json'),JSON.stringify({status:'pass',scope:'real CLI / stdio / canonical recovery; controlled external backend, no live model-history claim',threadId:id,turns:final.thread.turns.map(turn=>({id:turn.id,status:turn.status})),cli:{path:cli,sha256:sha(cli)},appServer:{path:server,sha256:sha(server)},firstCompressedSha256:copied.compressedSha256,secondCompressedSha256:twice.compressedSha256,runs,requests},null,2)+'\n');
 console.log(JSON.stringify({status:'pass',threadId:id,turnCount:3}));
}catch(error){fs.writeFileSync(path.join(evidence,'compressed-cli-r24-failure.json'),JSON.stringify({error:String(error),temp,runs},null,2)+'\n');throw error;}
